# Optional local-only ServeFlow synthetic business data; no real credentials.
# Keep the original model/Redis/Chroma configuration separate.
SERVEFLOW_DEMO_MYSQL_URL=mysql+pymysql://<SELECT_ONLY_USER>:<URL_ENCODED_PASSWORD>@127.0.0.1:13306/serveflow_demo_<NEW_DATABASE>
SERVEFLOW_DEMO_SESSION_KEY_FILE=/absolute/private/directory/demo-session.key
SERVEFLOW_DEMO_ORIGINS=http://127.0.0.1:5173

# Only for an explicit administrative CLI operation, never the web runtime:
# SERVEFLOW_DEMO_ADMIN_MYSQL_URL=mysql+pymysql://<INITIALIZER_USER>:<URL_ENCODED_PASSWORD>@127.0.0.1:13306/serveflow_demo_<NEW_DATABASE>
# python -B -m demo_business init
# python -B -m demo_business verify

# No runtime DDL, seed, arbitrary customer selection, SQLite fallback or refunds.
# Session key must be 32 random bytes in a current-user-owned 0600 regular file.
# This optional feature rejects production mode and public/non-loopback origins.
