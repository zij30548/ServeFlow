# Copy to backend/.env and fill only on your own machine. Never commit .env.
# Bailian Beijing Anthropic-compatible Messages API. No model request on startup.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=qwen3.7-flash-2026-07-15
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
# A Beijing workspace endpoint may instead use:
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/apps/anthropic

# Local development only; run.py binds 127.0.0.1:8816 with a single worker.
ECHOMIND_ENV=development
LOG_LEVEL=WARNING
ORT_DISABLE_TELEMETRY=1
PYTHONDONTWRITEBYTECODE=1

# Start your own local Redis first. No fixed passwords are distributed.
REDIS_URL=redis://127.0.0.1:6379/0
# Development uses embedded Chroma when a local Chroma server is unavailable.
# The cached local MiniLM model may require a one-time download on a new machine.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
ECHOMIND_SEED_DEMO_DOCS=true
EVAL_BASELINE_PATH=./data/eval/baseline.json

# Intent template similarity is local. No remote Embedding key or automatic MCP.
INTENT_EMBEDDING_PROVIDER=local
SILICONFLOW_API_KEY=
MCP_EXTERNAL_ENABLED=false
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# Per-call deadlines; the chat API keeps its separate 50-second deadline.
ECHOMIND_INTENT_TIMEOUT_S=8
ECHOMIND_LLM_TIMEOUT_S=15
ECHOMIND_COMPOSER_TIMEOUT_S=8

# Optional local synthetic MySQL orders: see .env.demo.example.
# Leave unset to keep the demo database feature disabled.
# SERVEFLOW_DEMO_MYSQL_URL=
# SERVEFLOW_DEMO_SESSION_KEY_FILE=
# SERVEFLOW_DEMO_ORIGINS=http://127.0.0.1:5173

# Optional E2E trial only. A separately created, seeded synthetic database and
# SELECT-only account are required. Never reuse the application/demo database.
# No automatic database creation, migration, seeding or model authorization.
# SERVEFLOW_EVAL_MYSQL_URL=mysql+pymysql://<SELECT_ONLY_USER>:<URL_ENCODED_PASSWORD>@127.0.0.1:13306/serveflow_demo_eval_<NEW_DATABASE>

# Public deployment is not configured by this example. Production mode requires
# separate non-model API tokens, Redis/Chroma access control, and a reviewed proxy.
# ECHOMIND_API_TOKENS=
